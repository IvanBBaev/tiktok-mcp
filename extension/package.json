{
  "name": "tiktok-mcp-ai",
  "displayName": "TikTok MCP",
  "description": "Drive TikTok from VS Code Copilot Chat — 11 tools over the Display and Content Posting APIs, with plan-then-execute write safety, OAuth 2.0 (PKCE) authorization and an append-only publish journal.",
  "version": "0.0.0",
  "publisher": "ivanbbaev",
  "author": "Ivan Baev",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/IvanBBaev/tiktok-mcp.git"
  },
  "homepage": "https://ivanbbaev.github.io/tiktok-mcp/",
  "bugs": {
    "url": "https://github.com/IvanBBaev/tiktok-mcp/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "tiktok",
    "mcp",
    "copilot",
    "content-posting",
    "model-context-protocol"
  ],
  "activationEvents": [
    "onLanguageModelChat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "tiktok-mcp-ai",
        "label": "TikTok MCP"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.5.0"
  }
}
