# tiktok-mcp-ai — example environment file
#
# Copy the values you need into your real env file and fill them in. The server
# resolves the env file in this order:
#   1. TT_ENV_FILE (explicit path)
#   2. $XDG_CONFIG_HOME/tiktok-mcp-ai/.env  (fallback ~/.config/tiktok-mcp-ai/.env)  [POSIX]
#   3. %LOCALAPPDATA%\tiktok-mcp-ai\.env                                             [Windows]
# Real environment variables always take precedence over the file.
#
# The file holds secrets — it is written owner-only (0600) on POSIX and should
# never be committed. Only the two variables at the top are required; everything
# else is optional tuning shown with its default. Token values are written by
# `login` / refresh — do NOT set them by hand.
# Full reference: docs/CONFIGURATION.md

# --- Required: TikTok app credentials ---
TT_CLIENT_KEY=
TT_CLIENT_SECRET=

# --- Media (needed to post LOCAL files; omit for URL-based posting only) ---
# The only directory FILE_UPLOAD tools may read from; unset => source:"file" is
# rejected locally (fail-closed). Use a dedicated media folder, never $HOME.
# TT_MEDIA_ROOT=
# Comma-separated https:// prefixes verified in the developer portal, so the plan
# phase can flag unverifiable PULL_FROM_URL domains early. Advisory only.
# TT_VERIFIED_URL_PREFIXES=

# --- Tool surface & write policy ---
# Packages/profile to register: auth,user,video,publish,publish-write — or a
# profile: core (all reads, default) | all (reads + write tools).
# TT_TOOL_PACKAGES=core
# Packages forced off even if enabled above (deny always wins).
# TT_PACKAGES_DENY=
# 1 registers only read-only tools (drops publish-write).
# TT_PACKAGES_READONLY=0
# Write behavior: plan (preview then plan_id, default) | apply (trusted
# automation only — NO injection resistance) | deny (publish-write not registered).
# TT_WRITE_MODE=plan
# Lifetime (seconds) of a minted plan_id before it expires.
# TT_PLAN_TTL_S=600
# Cap on outstanding previews kept in memory (oldest evicted first).
# TT_PLAN_MAX_OUTSTANDING=32
# Default for the AIGC (is_aigc) label on posts; on by default.
# TT_DEFAULT_AIGC_LABEL=1

# --- Accounts / profiles ---
# Profile used when a tool call has no `account` argument.
# TT_ACTIVE_PROFILE=DEFAULT
# Pin the session to one profile: an explicit `account` for any other fails locally.
# TT_LOCK_PROFILE=
# Extra account profiles are written by `login --profile <name>`, e.g.:
# TT_PROFILE_BRAND_ACCESS_TOKEN=...

# --- OAuth / login ---
# Optional fixed-port pin for the login loopback server; unset binds 127.0.0.1:0.
# TT_REDIRECT_PORT=
# Scopes requested by `login`; default is least-privilege from TT_TOOL_PACKAGES.
# TT_LOGIN_SCOPES=
# Refresh the access token this many seconds before its expiry.
# TT_TOKEN_REFRESH_SKEW_S=1800

# --- Tokens (written by `login`/refresh — DO NOT set by hand; secret) ---
# TT_ACCESS_TOKEN=
# TT_REFRESH_TOKEN=
# TT_OPEN_ID=
# TT_SCOPES=
# TT_TOKEN_EXPIRES_AT=
# TT_REFRESH_EXPIRES_AT=

# --- Transport ---
# stdio (default, no socket) | http (Streamable HTTP for remote/agent clients).
# TT_TRANSPORT=stdio
# Bind host for the http transport (loopback by default).
# TT_HTTP_HOST=127.0.0.1
# TCP port for the http transport.
# TT_PORT=3000
# Bearer token — REQUIRED whenever TT_TRANSPORT=http (loopback included); secret.
# TT_HTTP_TOKEN=
# 1 acknowledges a non-loopback bind without TLS termination in front.
# TT_HTTP_INSECURE=0

# --- HTTP client, limits & output ---
# Per-request timeout (ms).
# TT_TIMEOUT_MS=30000
# Upload request timeout (ms).
# TT_UPLOAD_TIMEOUT_MS=120000
# Retry cap for the idempotent read class (publish inits are never retried).
# TT_MAX_RETRIES=3
# Per-chunk upload retry cap (identical Content-Range on replay).
# TT_CHUNK_RETRIES=3
# Per-host concurrency semaphore.
# TT_MAX_CONCURRENT=4
# Local token bucket for publish inits, per profile.
# TT_PUBLISH_RPM=6
# Item cap for fetch_all pagination; a capped read surfaces `truncated`.
# TT_FETCH_ALL_CAP=200
# Truncation budget for tool results (always valid JSON).
# TT_RESULT_CHAR_BUDGET=25000
# 1 pretty-prints results (costs tokens).
# TT_PRETTY_JSON=0
# Bounded polling for publish status (ms).
# TT_STATUS_POLL_INTERVAL_MS=5000
# TT_STATUS_POLL_TIMEOUT_MS=60000
# stderr log level: error | warn | info | debug (never logs secret-bearing bodies).
# TT_LOG_LEVEL=info

# --- Env file, journal & cross-process lock ---
# Explicit path to the env file to read/write; the journal and lock follow it.
# TT_ENV_FILE=
# Max size of journal.ndjson before rotation.
# TT_JOURNAL_MAX_BYTES=5242880
# Env-file lock timings (ms): heartbeat, stale threshold, max wait.
# TT_ENV_LOCK_HEARTBEAT_MS=2000
# TT_ENV_LOCK_STALE_MS=15000
# TT_ENV_LOCK_WAIT_MS=30000
