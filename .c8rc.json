{
  "all": true,
  "src": ["build/src"],
  "excludeAfterRemap": true,
  "exclude": ["src/index.ts", "src/**/*.test.ts", "test/**", "scripts/**", "**/*.d.ts"],
  "reporter": ["text", "text-summary", "lcov", "json", "json-summary"],
  "reports-dir": "coverage",
  "check-coverage": true,
  "lines": 90,
  "branches": 80,
  "functions": 95,
  "statements": 90
}
